# ==============================================================================
# AI SERVICE ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=LinhKien_DB
DB_SCHEMA=LinhKien

# Read-only user for Text-to-SQL (Least Privilege)
DB_USER=text2sql_readonly
DB_PASSWORD=doi_mat_khau_nay

# Manager user (CLS restrictions applied)
DB_MANAGER_USER=manager_readonly
DB_MANAGER_PASSWORD=manager_readonly_pwd

# Admin superuser (Restricted to DDL / Migrations)
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=

# Security Controls
ALLOW_ADMIN_CONNECTION=0
ALLOW_ADMIN_FALLBACK=0
SANDBOX_DSN=

# Service Limits
MAX_QUESTION_LEN=300
MAX_ROWS=500
DEFAULT_LIMIT=50
MAX_LIMIT=100
CORS_ALLOW_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# ==============================================================================
# THAM SỐ TỐI ƯU 6 MODULE AI (tùy chọn - có giá trị mặc định hợp lý)
# ==============================================================================
# AI 1: Bộ phân loại học máy dự phòng (TF-IDF + Logistic Regression)
ML_FALLBACK_ENABLED=1
ML_ACCEPT_THRESHOLD=0.55
ML_SUGGEST_THRESHOLD=0.30

# AI 2: Trọng số xếp hạng lai (chạy "python ai_service/eval/eval_semantic.py --tune" để dò trọng số tối ưu)
SEM_WEIGHT_WORD=0.5
SEM_WEIGHT_CHAR=0.2
SEM_WEIGHT_KG=0.3
SEM_MIN_RELEVANCE=0.05
SEM_INDEX_TTL_SECONDS=600

# AI 3: Trọng số thành phần học máy (Isolation Forest + hồ sơ người dùng)
WEIGHT_ANOMALY=20
WEIGHT_USER_DEVIATION=15

# AI 6: Thư mục sao lưu ngoài máy chủ (ổ khác / NAS / thư mục đồng bộ cloud)
BACKUP_OFFSITE_DIR=
